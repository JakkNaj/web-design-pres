---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/site';
import Arrow from './Arrow.astro';
interface Props { coaches: CollectionEntry<'coaches'>[]; detailed?: boolean }
const { coaches, detailed = false } = Astro.props;
const Heading = detailed ? 'h2' : 'h3';
---
<div class:list={['trainer-cards', { 'trainer-cards-detailed': detailed }]}>
  {coaches.filter(c => c.data.portrait).map(c => {
    const words = c.data.name.split(' ');
    const surname = words.pop();
    return (
      <article class="trainer-card" id={detailed ? c.id : undefined}>
        <div class="trainer-card-header">
          <div class="trainer-card-photo">
            <Image src={c.data.portrait!} alt={c.data.name} width={Math.min(c.data.portrait!.width, 320)} loading="lazy" />
          </div>
          <div class="trainer-card-heading">
            <Heading><span>{words.join(' ')}</span>{' '}{surname}</Heading>
            <p class="trainer-card-summary">{c.data.summary}</p>
          </div>
        </div>
        <div class="trainer-card-description">
          {detailed && <p class="trainer-card-intro">{c.data.intro}</p>}
          {(detailed ? c.data.body : c.data.body.slice(0, 1)).map(p => <p>{p}</p>)}
        </div>
        {detailed ? (
          <ul class="trainer-card-experience">{c.data.credentials.map(p => <li>{p}</li>)}</ul>
        ) : (
          <a class="trainer-card-link" href={url(`treneri/#${c.id}`)} aria-label={`Více o trenérovi: ${c.data.name}`}>Celý medailonek <Arrow diagonal /></a>
        )}
      </article>
    );
  })}
</div>

<style>
  .trainer-cards { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px; }
  .trainer-card { --trainer-accent:var(--accent); --trainer-tint:var(--ice); display:flex; flex-direction:column; padding:30px; background:#f7f8f8; border:1px solid #e8ebec; min-width:0; scroll-margin-top:35px; }
  .trainer-card:nth-child(even) { --trainer-accent:var(--red); --trainer-tint:var(--rose); }
  .trainer-card-header { display:grid; grid-template-columns:132px minmax(0,1fr); align-items:start; gap:28px; }
  .trainer-card-photo { width:132px; aspect-ratio:4 / 5; overflow:hidden; background:var(--trainer-tint); }
  .trainer-card-photo img { width:100%; height:100%; object-fit:cover; object-position:50% 18%; }
  .trainer-card-heading { padding-top:12px; }
  .trainer-card-heading::before { content:''; display:block; width:28px; height:4px; background:var(--trainer-accent); margin-bottom:16px; }
  .trainer-card h2,.trainer-card h3 { font-size:clamp(27px,2.3vw,35px); line-height:1.08; letter-spacing:-.045em; margin:0; text-wrap:initial; }
  .trainer-card h2 span,.trainer-card h3 span { display:block; }
  .trainer-card-summary { color:var(--trainer-accent); font-size: 14px; line-height:1.55; margin-top:14px; max-width:265px; }
  .trainer-card-description { margin-top:25px; }
  .trainer-card-description p { font-size: 16px; line-height:1.8; color:#53575b; max-width:600px; }
  .trainer-card-description p+p { margin-top:12px; }
  .trainer-card-description .trainer-card-intro { color:var(--ink); font-size: 17px; line-height:1.5; font-weight:500; }
  .trainer-card-link { display:flex; align-items:center; justify-content:space-between; gap:20px; min-height:44px; padding-top:16px; margin-top:auto; font-size: 14px; color:var(--trainer-accent); width:fit-content; }
  .trainer-card-link .arrow { width:16px; }
  .trainer-card-experience { list-style:none; padding:20px 0 0; margin:24px 0 0; border-top:1px solid #dce2e4; display:grid; gap:12px; }
  .trainer-card-experience li { display:flex; gap:12px; font-size: 14px; line-height:1.6; color:#53575b; }
  .trainer-card-experience li::before { content:''; flex:0 0 7px; height:7px; margin-top:6px; border-radius:50%; background:var(--trainer-accent); }
  @media (hover:hover) and (pointer:fine) { .trainer-card-link:hover { text-decoration:underline; text-underline-offset:5px; } }
  @media (max-width:1050px) { .trainer-card { padding:24px; } .trainer-card-header { grid-template-columns:110px minmax(0,1fr); gap:22px; } .trainer-card-photo { width:110px; } .trainer-card h2,.trainer-card h3 { font-size: 27px; } }
  @media (max-width:760px) { .trainer-cards { grid-template-columns:1fr; gap:20px; } .trainer-card-header { grid-template-columns:120px minmax(0,1fr); gap:24px; } .trainer-card-photo { width:120px; } .trainer-card h2,.trainer-card h3 { font-size: 32px; } }
  @media (max-width:420px) { .trainer-card-heading { padding-top:0; } .trainer-card { padding:20px; } .trainer-card-header { grid-template-columns:96px minmax(0,1fr); gap:20px; } .trainer-card-photo { width:96px; } .trainer-card h2,.trainer-card h3 { font-size: 27px; } .trainer-card-heading::before { margin-bottom:12px; } .trainer-card-summary { font-size: 13px; margin-top:10px; } .trainer-card-description { margin-top:22px; } .trainer-card-description p { font-size: 16px; } }
  @media (max-width:360px) { .trainer-card-header { grid-template-columns:82px minmax(0,1fr); gap:14px; } .trainer-card-photo { width:82px; } .trainer-card h2,.trainer-card h3 { font-size: 23px; } .trainer-card { padding:18px; } }
</style>
