---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import HockeyTrail from '../components/HockeyTrail.astro';
import HockeyAccent from '../components/HockeyAccent.astro';
import GoalieSave from '../components/GoalieSave.astro';
import CoachCards from '../components/CoachCards.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Schedule from '../components/Schedule.astro';
import { siteContent, url, campUrl } from '../lib/site';
import { eventState, dateRange } from '../lib/events';
import { questions } from '../data/training';
import mask from '../assets/mask.jpg';
import goalieReady from '../assets/goalie-ready.jpg';
import maskIllustration from '../assets/mask-illustration.png';
const { camps, galleryMap, articles, coaches, partners } = await siteContent();
const nextCamp = camps.find(c => eventState(c.data) !== 'completed' && (!c.data.start || Date.parse(c.data.start)>Date.now()));
const campTraining = galleryMap.get('gallery-20')!;
const team = galleryMap.get('gallery-24')!;
const programs = [
 { title:'Jen ty a tvůj posun.', type:'Individuální trénink', description:'Práce na konkrétním detailu. Technika, pohyb a okamžitá zpětná vazba.', photo:{ image:goalieReady, alt:'Soustředěný brankář v černočervené výstroji připravený na střelu' }, href:'#terminy', filter:'individual', className:'program-young' },
 { title:'Lepší ve hře. Společně.', type:'Malé skupiny', description:'Herní situace, soustředění a prostor pro otázky. Každý gólman má svůj úkol.', photo:team.data.photos[19], href:'#terminy', filter:'group', className:'program-team' },
 { title:'Ponoř se do toho.', type:'Gólmanské kempy', description:'Led, suchá příprava i video. Několik dní, které patří brankářskému řemeslu.', photo:campTraining.data.photos[98], href:url('kempy/'), filter:undefined, className:'program-camp' },
];
const milestones = [2012,2013,2014,2017,2026].map(year=>camps.find(c=>c.id===`letni-special-${year}`)!);
---
<Layout><main id="obsah">
    <section class="hero" aria-labelledby="hero-title">
      <Image class="hero-image" src={mask} alt="Soustředěný hokejový brankář v bílé masce těsně před zákrokem" widths={[750, 1200, 1600, 2200]} sizes="100vw" loading="eager" fetchpriority="high" quality={85} />
      <div class="hero-copy"><p class="eyebrow">ALTRICHTER GOALIE ACADEMY</p><h1 id="hero-title">KAŽDÝ PUK.<br />TVŮJ <br /><span class="hero-moment">MOMENT.</span></h1><p>Klid v hlavě. Jistota v bráně.<br />Trénink, který tě připraví na obojí.</p><a class="button button-light button-ice" href="#treninky">Najít svůj trénink <Arrow /></a></div>
      <div class="hero-stamp" aria-hidden="true"><span>ODVAHA</span><strong>SE TRÉNUJE.</strong><svg viewBox="0 0 70 65" fill="none"><path d="M8 11c35-12 54 15 30 40m-8-14 6 17 19-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
      <div class="hero-bottom"><span>GÓLMANEM TĚ DĚLÁ VÍC NEŽ VÝSTROJ.</span><a href="#treninky" aria-label="Objevit tréninky"><svg width="18" height="23" viewBox="0 0 18 23" fill="none" aria-hidden="true"><path d="M9 1v20m-7-7 7 7 7-7" stroke="currentColor" stroke-width="1.5" /></svg></a></div>
    </section>


    <ul class="experience-line" aria-label="Naše zkušenosti a přístup" role="list">
      <li>Trénink se zkušenými profesionály</li>
      <li>Roky práce s brankáři</li>
      <li>Osobní přístup. Trénink na míru.</li>
      <li>Péče o každý detail</li>
    </ul>
    {nextCamp && <aside class="next-camp" data-upcoming data-start={nextCamp.data.start}><div><p class="eyebrow">DALŠÍ SPOLEČNÝ LED {nextCamp.data.demo&&'· UKÁZKOVÝ TERMÍN'}</p><strong>{dateRange(nextCamp.data.start,nextCamp.data.end)}</strong></div><div><h2>{nextCamp.data.title}</h2><p>{nextCamp.data.venue} · {nextCamp.data.location}</p></div><a class="button" href={campUrl(nextCamp.id)}>Prohlédnout kemp <Arrow diagonal /></a></aside>}
    <section class="section programs" id="treninky"><div class="section-heading"><div><p class="eyebrow">01 / NAJDI SVOU CESTU</p><h2>Tvoje brána. Tvoje pravidla.</h2><p class="photo-provenance">Skupiny a kempy: fotografie akademie z Říčan, 2023 a 2017. Individuální trénink: ilustrační fotografie.</p></div><p>Každý gólman je jiný.<br />Tvůj trénink by měl být taky.</p></div><div class="program-grid">{programs.map((p,i)=><a class={`program ${p.className}`} href={p.href} data-program={p.filter}><div class="program-photo"><Image src={p.photo.image} alt={p.photo.alt} widths={[400,650,950]} sizes="(max-width:600px) 100vw, 33vw" /><span class="photo-label">{p.type}</span><span class="program-number">0{i+1}</span><span class="round-arrow"><Arrow diagonal /></span></div><h3>{p.title}</h3><p>{p.description}</p></a>)}</div></section>
    <section class="approach section" id="pristup" aria-labelledby="approach-title">
      <GoalieSave />
      <div class="approach-copy"><p class="eyebrow">02 / VÍC NEŽ JEN ZÁKROK</p><h2 id="approach-title">Rychlé ruce.<br />Pevný základ.<br /><span>Klidná hlava.</span></h2><p>Technika bruslení a zákroků, čtení hry i práce s videem. Na ledě hledáme souvislosti. Mimo něj rozvíjíme pohyb, stabilitu a soustředění.</p><div class="principles"><div><span>01</span><p>Bruslení, zákroky a hra holí.</p></div><div><span>02</span><p>Čtení hry a zpětná vazba ve videu.</p></div><div><span>03</span><p>Suchá a mentální příprava.</p></div></div></div>
    </section>


    <section class="section people-section" id="akademie"><div class="section-heading"><div><p class="eyebrow">03 / LIDÉ ZA TRÉNINKEM</p><div class="accent-heading"><h2>Zkušenost, kterou<br />předáváme dál.</h2><HockeyAccent variant="tactics" class="heading-accent" /></div></div><p>Roky v bráně. Pozornost k detailu.<br />A čas na tvé otázky.</p></div><CoachCards coaches={coaches} /><a class="text-link" href={url('treneri/')}>Poznej trenéry akademie <Arrow diagonal /></a></section>
    <section class="history-band"><div class="section-heading"><div><p class="eyebrow">04 / ROKY PRÁCE NA LEDĚ</p><h2>SEZONA ZA SEZONOU.<br /><span>POŘÁD DÁL.</span></h2></div><p>Od Berouna přes Jihlavu a Havlíčkův Brod<br />až k dnešním Říčanům. Tohle je naše cesta.</p></div><div class="milestone-grid">{milestones.map(c=>{const g=galleryMap.get(c.data.gallery!.id)!;const photo=g.data.photos[g.data.coverIndex];return <a href={campUrl(c.id)} class="milestone"><span class="milestone-year">{c.data.year}</span><Image src={photo.image} alt={photo.alt} width={420} /><h3>{c.data.location} <span aria-hidden="true">↗</span></h3></a>})}</div><div class="history-signoff"><a class="button button-light" href={url('historie/')}>Celý příběh akademie <Arrow /></a><HockeyAccent variant="rink" class="history-accent" /></div></section>
    <Schedule />
    <section class="section news-section"><div class="section-heading"><div><p class="eyebrow">ZE ŽIVOTA AKADEMIE</p><div class="accent-heading"><h2>Práce, která je vidět.</h2><HockeyAccent variant="puck" class="heading-accent" /></div></div><a class="text-link" href={url('aktuality/')}>Všechny příběhy <Arrow diagonal /></a></div><div class="article-grid">{articles.slice(0,3).map(a=><ArticleCard article={a} gallery={a.data.gallery?galleryMap.get(a.data.gallery.id):undefined} />)}</div></section>
    <section class="section partners-section"><div class="section-heading"><div><p class="eyebrow">SPOLEČNĚ ZA LEPŠÍ HROU</p><h2>Partneři akademie.</h2></div></div><div class="partner-grid">{partners.map(p=><a href={p.data.url} target="_blank" rel="noopener noreferrer" aria-label={`${p.data.name} — web partnera`}><Image src={p.data.logo} alt={p.data.name} width={300} /></a>)}</div></section>
    <section class="section faq" aria-labelledby="faq-title"><div><p class="eyebrow">JEŠTĚ NEŽ VYRAZÍŠ</p><h2 id="faq-title">Dobré vědět.</h2><p>Na led s čistou hlavou.<br />A se vším, co potřebuješ.</p><div class="faq-illustration" aria-hidden="true"><Image src={maskIllustration} alt="" width={160} /><span>HLAVU<br />V KLIDU.</span></div></div><div class="faq-list">{questions.map(([question, answer]) => <details name="faq"><summary>{question}<span class="faq-icon" aria-hidden="true"></span></summary><p>{answer}</p></details>)}</div></section>

    <section class="final-cta" id="dalsi-krok" aria-labelledby="contact-title"><HockeyTrail class="cta-tactics" /><p class="eyebrow">TVŮJ DALŠÍ ZÁKROK ZAČÍNÁ TADY.</p><h2 id="contact-title">POSTAV SE DO TOHO.</h2><p>Zbytek společně odchytáme.</p><a class="button button-light button-ice" href="#terminy">Najít svůj trénink <Arrow /></a><svg class="cta-puck" width="170" height="91" viewBox="0 0 64 35" fill="none" aria-hidden="true"><path d="M3 11v12c0 14 58 14 58 0V11" stroke="currentColor" stroke-width=".5"/><ellipse cx="32" cy="11" rx="29" ry="10" stroke="currentColor" stroke-width=".5"/><ellipse cx="32" cy="11" rx="23" ry="7" stroke="currentColor" stroke-width=".3"/></svg></section>
</main></Layout>
