---
import HockeyAccent from '../../components/HockeyAccent.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import ArchiveVideo from '../../components/ArchiveVideo.astro';
import CoachCards from '../../components/CoachCards.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { siteContent, url, campUrl, contact } from '../../lib/site';
import { eventState, canRegister, stateLabels, dateRange } from '../../lib/events';
export async function getStaticPaths(){return (await getCollection('camps',c=>!c.data.draft)).map(camp=>({params:{id:camp.id},props:{camp}}));}
const { camp }=Astro.props; const data=camp.data;
const { galleryMap, camps, articles, coaches }=await siteContent();
const gallery=data.gallery?galleryMap.get(data.gallery.id):undefined;
const state=eventState(data); const completed=state==='completed';
const related=articles.filter(a=>a.data.camp?.id===camp.id);
const next=camps.find(c=>c.id!==camp.id&&c.data.series===data.series&&eventState(c.data)!=='completed');
const selectedCoaches=coaches.filter(c=>data.coaches.some(ref=>ref.id===c.id));
---
<Layout title={`${data.title} | Altrichter Goalie Academy`} description={data.summary}><main id="obsah">
<section class="page-intro dark"><div class="container"><HockeyAccent variant="puck" class="intro-accent" /><a class="breadcrumb" href={url(completed?'historie/':'kempy/')}>← {completed?'Naše historie':'Všechny kempy'}</a><p class="eyebrow">{data.location} · {data.year}</p><h1>{data.title}</h1><div class="intro-meta"><span class="status-pill" data-event-state data-end={data.end} data-state={state}>{stateLabels[state]}</span><span>{dateRange(data.start,data.end)}</span></div><p class="lead">{data.summary}</p>{data.demo&&<p class="inline-demo">Ukázkový kemp pro tento návrh webu. Termín ani přihláška nepředstavují skutečnou nabídku či rezervaci.</p>}</div></section>
{gallery&&<div class="container detail-hero"><Image src={gallery.data.photos[gallery.data.coverIndex].image} alt={gallery.data.photos[gallery.data.coverIndex].alt} width={1400}/><p class="photo-caption">{gallery.data.title} · skutečné fotografie tohoto ročníku</p></div>}
<section class="section container story-layout"><div class="prose"><p class="eyebrow">{completed?'Příběh ročníku':'Na co se těšit'}</p><h2>{completed?'Práce, která zůstává.':'Prostor pro váš posun.'}</h2>{data.body.map(p=><p>{p}</p>)}{!completed&&<><h3>Program</h3><ul>{data.program.map(p=><li>{p}</li>)}</ul><h3>Praktické informace</h3><ul>{data.practical.map(p=><li>{p}</li>)}</ul></>}</div><aside class="detail-facts"><p class="eyebrow">{completed?'Údaje o proběhlém ročníku':'Přehled kempu'}</p><dl><dt>Termín</dt><dd>{dateRange(data.start,data.end)}</dd><dt>Místo</dt><dd>{data.venue} · {data.location}</dd>{data.age&&<><dt>Pro koho</dt><dd>{data.age}</dd></>}{data.capacity&&<><dt>Kapacita</dt><dd>{data.capacity}</dd></>}<dt>{completed?'Tehdejší cena':'Cena'}</dt><dd>{data.price??(completed?'V publikovaném výběru neuvedena':'Bude upřesněna')}</dd></dl><div class="camp-actions">{canRegister(data)?<button class="button button-dark" data-register={`camp:${camp.id}`}>Vyzkoušet přihlášku ↗</button>:<p>{completed?'Tento ročník už proběhl.':state==='full'?'Kemp je obsazený. Ozvěte se nám pro další možnosti.':state==='announced'?'Podrobnosti připravujeme.':'Přihlašování již skončilo.'}</p>}<a class="text-link" href={`mailto:${contact.email}`}>Kontaktovat akademii ↗</a></div></aside></section>
{gallery&&<section class="section container"><div class="section-heading"><p class="eyebrow">{data.year} · {gallery.data.photos.length} fotografií</p><h2>Takový byl náš kemp.</h2></div><GalleryGrid gallery={gallery}/></section>}
{completed&&(data.program.length>0||data.practical.length>0)&&<section class="container section"><details class="archive-details"><summary>Původní program a praktické informace ročníku {data.year}</summary><div class="prose"><p>Archivní informace. Nevztahují se k novým termínům.</p><h3>Program</h3><ul>{data.program.map(p=><li>{p}</li>)}</ul><h3>Praktické informace</h3><ul>{data.practical.map(p=><li>{p}</li>)}</ul></div></details></section>}
{selectedCoaches.length>0&&<section class="container section"><h2>Trenéři tohoto kempu.</h2><CoachCards coaches={selectedCoaches}/></section>}
{related.length>0&&<section class="container section"><div class="section-heading"><p class="eyebrow">Ze života akademie</p><h2>Více z tohoto ročníku.</h2></div><div class="article-grid">{related.map(article=><ArticleCard article={article} gallery={article.data.gallery?galleryMap.get(article.data.gallery.id):undefined}/>)}</div></section>}
<section class="container section related-block"><p class="eyebrow">Další krok</p><h2>Potkáme se na ledě?</h2><a class="button button-dark" href={next?campUrl(next.id):url('kempy/')}>{next?'Další ročník':'Prohlédnout nadcházející kempy'} ↗</a><a class="text-link" href={url('treneri/')}>Poznat trenéry ↗</a></section>
<ArchiveVideo gallery={gallery}/></main></Layout>