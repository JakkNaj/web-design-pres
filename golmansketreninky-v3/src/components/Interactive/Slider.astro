---
import type { HTMLAttributes } from "astro/types";
import Button from "@/components/Button.astro";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** What the slides hold, for anyone who cannot see them. Defaults to `Slider`. */
  label?: string;
  /**
   * How far the slides run past the container.
   *
   * - `bleed` — off both edges of the screen (default)
   * - `crop-start` — flush at the start, off the end
   * - `contained` — within the container on both sides
   */
  variant?: "bleed" | "crop-start" | "contained";
  /** Slides in view below 30rem, the base every larger size falls back to. Must be greater than 0. Defaults to 1.02.
   *
   * @min 1
   * @max 12
   * @int */
  xsmall?: number;
  /** Slides in view from 30rem up. Must be greater than 0. Inherits xsmall when unset.
   *
   * @min 1
   * @max 12
   * @int */
  small?: number;
  /** Slides in view from 48rem up. Must be greater than 0. Inherits small when unset.
   *
   * @min 1
   * @max 12
   * @int */
  medium?: number;
  /** Slides in view from 64rem up. Must be greater than 0. Inherits medium when unset.
   *
   * @min 1
   * @max 12
   * @int */
  large?: number;
};

const {
  render = true,
  label = "Fotografie",
  variant = "bleed",
  xsmall = 1.02,
  small,
  medium,
  large,
  class: className,
  ...rest
} = Astro.props;

const counts = { xs: xsmall, sm: small, md: medium, lg: large };

const invalid = Object.entries(counts).filter(
  ([, count]) => count !== undefined && !(Number.isFinite(count) && count > 0),
);

if (import.meta.env.DEV && invalid.length) {
  console.warn(
    `[lumos] <Slider> ignores ${invalid.map(([size]) => size).join(", ")}: slides in view must be greater than 0.`,
  );
}

const set = (count: number | undefined) =>
  count !== undefined && Number.isFinite(count) && count > 0;

const visible =
  [
    xsmall !== 1.02 && set(xsmall) && `--_visible-xs: ${xsmall}`,
    set(small) && `--_visible-sm: ${small}`,
    set(medium) && `--_visible-md: ${medium}`,
    set(large) && `--_visible-lg: ${large}`,
  ]
    .filter(Boolean)
    .join("; ") || undefined;

const slides = await slotContent(Astro.slots);
---

{
  render && slides && (
    <div
      class:list={["slider_wrap", variant !== "bleed" && variant, className]}
      style={visible}
      {...rest}
    >
      <div class="slider_list" role="group" aria-label={label} tabindex="0">
        <Fragment set:html={slides} />
      </div>

      <div class="slider_controls">
        <div class="slider_markers" />
        <div class="slider_steps">
          <Button
            variant="arrow"
            emphasis="secondary"
            direction="back"
            label="Předchozí fotografie"
            data-step="-1"
          />
          <Button
            variant="arrow"
            emphasis="secondary"
            label="Další fotografie"
            data-step="1"
          />
        </div>
      </div>
    </div>
  )
}

<script>
  const THRESHOLD = 4;

  for (const slider of document.querySelectorAll<HTMLElement>(".slider_wrap")) {
    const list = slider.querySelector<HTMLElement>(".slider_list");
    const markers = slider.querySelector<HTMLElement>(".slider_markers");
    const controls = slider.querySelector<HTMLElement>(".slider_controls");
    const steps = [
      ...slider.querySelectorAll<HTMLButtonElement>("[data-step]"),
    ];
    if (!list) continue;

    const slides = [...list.children] as HTMLElement[];
    if (slides.length === 0) continue;

    slides.forEach((slide, i) => {
      if (!slide.matches("button, a")) {
        slide.setAttribute("role", "group");
        slide.setAttribute("aria-label", `Fotografie ${i + 1} z ${slides.length}`);
      }
    });

    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const behavior = () => (reduced.matches ? "auto" : "smooth");

    const stride = () => {
      const first = slides[0].getBoundingClientRect();
      if (slides.length < 2) return first.width;
      return slides[1].getBoundingClientRect().left - first.left;
    };

    const view = () => {
      const box = getComputedStyle(list);
      return (
        list.clientWidth -
        parseFloat(box.paddingInlineStart) -
        parseFloat(box.paddingInlineEnd)
      );
    };

    const pages = () => {
      const step = stride();
      if (step <= 0) return 1;
      return Math.max(1, slides.length - Math.round(view() / step) + 1);
    };

    const current = () => {
      const step = stride();
      return step > 0 ? Math.round(list.scrollLeft / step) : 0;
    };

    let drawn = 0;

    const draw = (total: number) => {
      if (!markers) return;
      drawn = total;
      markers.replaceChildren(
        ...Array.from({ length: total }, (_, i) => {
          const marker = document.createElement("button");
          marker.type = "button";
          marker.className = "slider_marker";
          marker.setAttribute("aria-label", `Zobrazit fotografii ${i + 1}`);
          marker.addEventListener("click", () =>
            list.scrollTo({ left: i * stride(), behavior: behavior() }),
          );
          return marker;
        }),
      );
    };

    const sync = () => {
      const total = pages();
      if (total !== drawn) draw(total);

      const end = list.scrollWidth - list.clientWidth;
      const atStart = list.scrollLeft <= 1;
      const atEnd = list.scrollLeft >= end - 1;

      for (const step of steps) {
        step.disabled = Number(step.dataset.step) < 0 ? atStart : atEnd;
      }

      const viewport = list.getBoundingClientRect();
      for (const slide of slides) {
        if (!slide.matches("button, a")) continue;
        const bounds = slide.getBoundingClientRect();
        const visibleWidth = Math.min(bounds.right, viewport.right) - Math.max(bounds.left, viewport.left);
        slide.tabIndex = visibleWidth >= Math.min(44, bounds.width / 2) ? 0 : -1;
      }

      const index = atEnd ? total - 1 : Math.min(total - 1, current());
      markers?.querySelectorAll(".slider_marker").forEach((marker, i) => {
        marker.classList.toggle("is-active", i === index);
        if (i === index) marker.setAttribute("aria-current", "true");
        else marker.removeAttribute("aria-current");
      });

      controls?.classList.toggle("is-empty", end <= 1);
    };

    for (const step of steps) {
      step.addEventListener("click", () =>
        list.scrollBy({
          left: Number(step.dataset.step) * stride(),
          behavior: behavior(),
        }),
      );
    }

    list.addEventListener("keydown", event => {
      if (event.target !== list || !["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
      event.preventDefault();
      const left = event.key === "Home" ? 0 : event.key === "End" ? list.scrollWidth : list.scrollLeft + (event.key === "ArrowLeft" ? -1 : 1) * stride();
      list.scrollTo({ left, behavior: behavior() });
    });

    let origin = 0;
    let from = 0;
    let pressed = false;
    let dragged = false;

    const restore = () => {
      if (!pressed) list.classList.remove("is-dragging");
    };

    list.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "mouse" || event.button !== 0) return;
      if (list.scrollWidth <= list.clientWidth) return;
      pressed = true;
      dragged = false;
      origin = event.clientX;
      from = list.scrollLeft;
    });

    list.addEventListener("pointermove", (event) => {
      if (!pressed) return;
      const shift = event.clientX - origin;
      if (!dragged) {
        if (Math.abs(shift) < THRESHOLD) return;
        dragged = true;
        list.setPointerCapture(event.pointerId);
        list.classList.add("is-dragging");
      }
      list.scrollLeft = from - shift;
    });

    const release = () => {
      if (!pressed) return;
      pressed = false;
      setTimeout(() => { dragged = false; }, 0);
      const step = stride();
      if (dragged && step > 0) {
        list.scrollTo({
          left: Math.round(list.scrollLeft / step) * step,
          behavior: behavior(),
        });
      }
      list.addEventListener("scrollend", restore, { once: true });
      setTimeout(restore, 400);
    };

    window.addEventListener("pointerup", release);
    list.addEventListener("lostpointercapture", release);
    list.addEventListener("pointercancel", release);
    list.addEventListener("dragstart", (event) => event.preventDefault());

    list.addEventListener(
      "click",
      (event) => {
        if (!dragged) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        dragged = false;
      },
      true,
    );

    let frame = 0;
    list.addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(sync);
      },
      { passive: true },
    );

    slider.classList.add("is-ready");

    const resize = new ResizeObserver(sync);
    resize.observe(list);

    addEventListener("load", sync);
    sync();
  }
</script><style is:global>
  @layer components {
    .slider_wrap {
      --_gap-size: var(--site-gutter);
      --_edge: max(var(--site-margin), (100vw - var(--max-width-main)) / 2);
      --_visible: var(--_visible-xs);
      --_visible-xs: 1.02;
      --_visible-sm: var(--_visible-xs);
      --_visible-md: var(--_visible-sm);
      --_visible-lg: var(--_visible-md);
      display: grid;
      gap: var(--space-6);
      width: 100%;

      @media (width >= 30rem) {
        --_visible: var(--_visible-sm);
      }
      @media (width >= 48rem) {
        --_visible: var(--_visible-md);
      }
      @media (width >= 64rem) {
        --_visible: var(--_visible-lg);
      }
    }

    .slider_list {
      display: flex;
      gap: var(--_gap-size);
      min-width: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      cursor: grab;
      margin-inline: calc(-1 * var(--_edge));
      padding-inline: var(--_edge);
      scroll-padding-inline: var(--_edge);

      &::-webkit-scrollbar {
        display: none;
      }

      &:active {
        cursor: grabbing;
      }

      &.is-dragging {
        scroll-snap-type: none;
        -webkit-user-select: none;
        user-select: none;
      }

      .slider_wrap:not(.is-ready) &,
      .slider_wrap:has(.slider_controls.is-empty) & {
        cursor: auto;
      }

      & > * {
        flex: 0 0
          calc(
            (100% - (var(--_visible) - 1) * var(--_gap-size)) / var(--_visible)
          );
        min-width: 0;
        scroll-snap-align: start;
      }

      .slider_wrap.crop-start & {
        margin-inline-start: 0;
        padding-inline-start: 0;
        scroll-padding-inline-start: 0;
      }

      .slider_wrap.contained & {
        margin-inline: 0;
        padding-inline: 0;
        scroll-padding-inline: 0;
      }
    }

    .slider_controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: var(--space-4);

      .slider_wrap:not(.is-ready) &,
      &.is-empty {
        display: none;
      }
    }

    .slider_markers {
      display: flex;
      align-items: center;
      gap: 0;
    }

    .slider_marker {
      width: 2.75rem;
      height: 2.75rem;
      position: relative;
      padding: 0;
      border: 0;
      border-radius: var(--radius-round);
      background: none;
      transition: background-color var(--hover-duration) var(--hover-ease);

      &::after { content: ""; position: absolute; inset: 1rem; border: var(--border-width) solid var(--text); border-radius: 50%; }
      &.is-active::after { background: var(--blue); border-color: var(--blue); }
      @media (hover: hover) {
        &:hover::after { background: var(--blue); }
      }
    }

    .slider_steps {
      margin-inline-start: auto;
      display: flex;
      gap: var(--space-2);
    }
  }
</style>
