---
interface Props { diagonal?: boolean; }
const { diagonal = false } = Astro.props;
---
<svg class:list={['academy-arrow', { diagonal }]} width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>

<style is:global>@layer components { .academy-arrow { width:1.125rem; height:1.125rem; flex:none; } .academy-arrow.diagonal { transform:rotate(-45deg); } }</style>