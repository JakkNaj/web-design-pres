---
import {
  Section,
  Grid,
  ContentWrapper,
  Heading,
  Paragraph,
  Eyebrow,
  Button,
  Card,
  Img,
  Accordion,
  AccordionItem,
} from "@/ui";
import SectionHeroMain from "./SectionHeroMain.astro";
import ContentSectionHeading from "./ContentSectionHeading.astro";
import ContentCoaches from "./ContentCoaches.astro";
import Arrow from "./Arrow.astro";
import SectionSchedule from "./SectionSchedule.astro";
import GoalieSave from "./GoalieSave.astro";
import { eventState, dateRange, dateLabel } from '@/lib/events';
import { siteContent, url, campUrl, articleUrl } from "@/lib/site";
import {historyMilestones, historyTotals} from '@/data/camp-history';
import { questions } from "@/data/training";
import maskIllustration from '@/assets/mask-illustration.png';
import goalieReady from "@/assets/goalie-ready.jpg";
import goalieCamp from "@/assets/goalie-camp-man07940.jpg";
const { camps, galleryMap, coaches, articles, partners } = await siteContent();
const nextCamp = camps.find(c => eventState(c.data) !== 'completed');

const team = galleryMap.get("gallery-24")!;
const programs = [
  {
    heading: "Jen ty a tvůj posun.",
    eyebrow: "01 / Individuální trénink",
    text: "Práce na konkrétním detailu. Technika, pohyb a okamžitá zpětná vazba.",
    image: goalieReady,
    alt: "Brankář připravený na střelu",
    href: "#terminy",
  },
  {
    heading: "Lepší ve hře. Společně.",
    eyebrow: "02 / Malé skupiny",
    text: "Herní situace, soustředění a prostor pro otázky. Každý gólman má svůj úkol.",
    image: team.data.photos[19].image,
    alt: team.data.photos[19].alt,
    href: "#terminy",
  },
  {
    heading: "Ponoř se do toho.",
    eyebrow: "03 / Gólmanské kempy",
    text: "Led, suchá příprava i video. Několik dní, které patří brankářskému řemeslu.",
    image: goalieCamp,
    alt: "Brankář v bílém dresu připravený na střelu na ledě",
    href: url("kempy/"),
    credit: { label: "Ondra_mann", href: "https://www.instagram.com/ondra_mann/" },
  },
];

---

<SectionHeroMain />
<Section paddingTop="none" paddingBottom="none" class="home-trust_wrap"><ul class="home-trust_list" aria-label="Naše zkušenosti a přístup" role="list"><li>Trénink se zkušenými profesionály</li><li>Roky práce s brankáři</li><li>Osobní přístup. Trénink na míru.</li><li>Péče o každý detail</li></ul></Section>
{nextCamp && <Section paddingTop="none" paddingBottom="none" class="home-next_wrap"><aside class="home-next_panel" data-upcoming data-start={nextCamp.data.start}><div><Eyebrow>Další společný led</Eyebrow><strong>{dateRange(nextCamp.data.start,nextCamp.data.end)}</strong></div><div><Heading tag="h2" variant="h5">{nextCamp.data.title}</Heading><Paragraph variant="small">{nextCamp.data.venue} · {nextCamp.data.location}</Paragraph></div><Button element="link" class="academy-white" href={campUrl(nextCamp.id)}>Prohlédnout kemp <Arrow diagonal/></Button></aside></Section>}
<Section id="treninky"
  ><ContentSectionHeading
    eyebrow="01 / Najdi svou cestu"
    title="Tvoje brána. Tvoje pravidla."
    ><Paragraph
      >Každý gólman je jiný.<br />Tvůj trénink by měl být taky.</Paragraph
    ></ContentSectionHeading
  ><Grid medium={3} class="home-programs_wrap"
    >{
      programs.map((p,i) => (
        <Card
          class="program"
          variant="stacked"
          heading={p.heading}
                    text={p.text}

        ><Fragment slot="visual"><a class="home-programs_photo" href={p.href} data-program={i===0?"individual":i===1?"group":undefined} aria-label={p.eyebrow}><Img src={p.image} alt={p.alt}/><span class="home-programs_label" aria-hidden="true">{p.eyebrow.split(' / ')[1]}</span><span class="home-programs_number" aria-hidden="true">0{i+1}</span><span class="home-programs_arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m6 18 12-12M6 6h12v12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>
        </Fragment>
          {p.credit && <Fragment slot="meta">
            <div class="home-programs_credit" data-photo-credit>
              <button class="home-programs_credit-trigger" type="button" aria-label="Zobrazit autora fotografie" aria-expanded="false" aria-controls={`program-photo-credit-${i}`}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 6l1.5-3h5L16 6h4a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="12" cy="13" r="4" stroke="currentColor" stroke-width="1.5"/></svg>
              </button>
              <div class="home-programs_credit-panel" id={`program-photo-credit-${i}`} aria-hidden="true" inert>
                <a href={p.credit.href} target="_blank" rel="noopener noreferrer" aria-label={`Foto: ${p.credit.label} — Instagram (otevře se v novém okně)`}>Foto: {p.credit.label} <span aria-hidden="true">↗</span></a>
              </div>
            </div>
          </Fragment>}
        </Card>
      ))
    }</Grid
  ></Section
>
<Section id="pristup" class="home-approach_wrap"
  ><ContentWrapper
    variant="columns"
    column1Class="home-approach_content"
    column2Class="home-approach_visual"
    ><Eyebrow>02 / Víc než jen zákrok</Eyebrow><Heading
      >Rychlé ruce.<br />Pevný základ.<br /><em>Klidná hlava.</em></Heading
    ><Paragraph
      >Technika bruslení a zákroků, čtení hry i práce s videem. Na ledě hledáme
      souvislosti. Mimo něj rozvíjíme pohyb a soustředění.</Paragraph
    ><ol class="home-approach_list">
      <li><span>01</span> Bruslení, zákroky a hra holí.</li><li>
        <span>02</span> Čtení hry a zpětná vazba ve videu.
      </li><li><span>03</span> Suchá a mentální příprava.</li>
    </ol><Fragment slot="column2"><GoalieSave /></Fragment></ContentWrapper
  ></Section
>
<Section id="akademie"
  ><ContentSectionHeading
    eyebrow="03 / Lidé za tréninkem"
    title="Zkušenosti z ligy.<br/>Pro tvůj další zákrok."
    ><Paragraph>Mistr extraligy i trenéři mládeže.<br/>Poznej tým, který tě vezme na led.</Paragraph></ContentSectionHeading>
  <ContentCoaches coaches={coaches}/><Button element="link" variant="link" href={url('treneri/')}>Poznej trenéry akademie <Arrow diagonal/></Button></Section>
<Section id="pribeh" class="home-history_wrap"
  ><ContentSectionHeading
    eyebrow="04 / Roky práce na ledě"
    title="Na ledě od roku <em>2012.</em>"
    ><Paragraph
      >Od prvních letních kempů přes tréninky na Kobře a ve Vyškově až po roky společné práce v Říčanech.</Paragraph
    ></ContentSectionHeading
  ><div class="home-history_summary" aria-label="Naše historie v číslech"><div class="home-history_total"><strong>{historyTotals.events}</strong><span>tréninků a kempů<br/>v naší historii</span></div><div><strong>{historyTotals.trainings}</strong><span>tréninků</span></div><div><strong>{historyTotals.camps}</strong><span>kempů a speciálů</span></div><div><strong>{historyTotals.venues}</strong><span>stadionů</span></div></div>
  <Grid class="home-history_list" role="list" aria-label="Milníky akademie">
    {historyMilestones.map(item=>{
      const c=camps.find(c=>c.id===item.campId);
      const g=c?.data.gallery?galleryMap.get(c.data.gallery.id):undefined;
      const photo=g?.data.photos[g.data.coverIndex];
      return <div class="home-history_item" role="listitem">
        <span class="home-history_year">{item.years}</span>
        {photo?<Img src={photo.image} alt={photo.alt}/>:<div class="home-history_placeholder" aria-hidden="true"><span>Archiv</span></div>}
        <span class="home-history_place">{item.city}</span>
        <span class="home-history_venue">{item.venueUrl ? <a href={item.venueUrl}>{item.venue} <span aria-hidden="true">↗</span></a> : item.venue}</span>
        <strong class="home-history_count">{item.detail}</strong>
      </div>;
    })}
  </Grid>
  <p class="home-history_note">Doložené tréninky, kempy a speciály z let 2012–2026.</p>
  <div class="home-history_signoff"><Button element="link" class="academy-white" href={url("historie/")}>Celý příběh akademie <Arrow/></Button></div></Section
>
<SectionSchedule />
<Section id="ze-zivota-akademie" paddingTop="small" class="home-news_wrap"
  ><ContentSectionHeading
    eyebrow="Ze života akademie"
    title="Práce, která je vidět." accent="puck"
    ><Button element="link" variant="link" href={url("aktuality/")}
      >Všechny příběhy <Arrow diagonal/></Button
    ></ContentSectionHeading
  ><Grid medium={3}
    >{
      articles.slice(0, 3).map((a) => {
        const g = a.data.gallery
          ? galleryMap.get(a.data.gallery.id)
          : undefined;
        const p = g?.data.photos[g.data.coverIndex];
        return (
          <Card variant="stacked" class="home-article" heading={a.data.title} text={a.data.summary} buttonLabel="Podívat se blíž ↗" buttonHref={articleUrl(a.id)}>
            <Fragment slot="visual"><a class="home-article_cover" href={articleUrl(a.id)} aria-label={a.data.title}><Img src={a.data.cover ?? p!.image} alt={a.data.coverAlt ?? p?.alt}/><span>{a.data.category}</span></a></Fragment>
            <Fragment slot="meta"><div class="home-article_meta"><time datetime={a.data.date}>{dateLabel(a.data.date)}</time><span>{g?.data.year}</span></div></Fragment>
          </Card>
        );
      })
    }</Grid
  ></Section
>
<Section paddingTop="small" paddingBottom="small" class="home-partners_wrap"
  ><ContentSectionHeading eyebrow="Společně za lepší hrou" title="Partneři akademie."/><div class="home-partners_list">
    {
      partners.map((p) => (
        <a
          href={p.data.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${p.data.name} — web partnera`}
        >
          <Img
            src={p.data.logo}
            alt={p.data.name}
            transparent
            variant="densities"
            width={200}
          />
        </a>
      ))
    }
  </div></Section
>
<Section id="otazky" class="home-faq_wrap"
  ><ContentWrapper variant="columns" column1Class="home-faq_intro"
    ><Eyebrow>Ještě než vyrazíš</Eyebrow><Heading>Dobré vědět.</Heading
    ><Paragraph
      >Na led s čistou hlavou.<br />A se vším, co potřebuješ.</Paragraph>
    <div class="home-faq_art" data-decor-motion aria-hidden="true"><Img src={maskIllustration} alt="" transparent variant="densities" width={160}/><span>HLAVU<br/>V KLIDU.</span></div>
    <Fragment slot="column2"
      ><Accordion
        >{
          questions.map(([question, answer]) => (
            <AccordionItem heading={question}>
              <Paragraph>{answer}</Paragraph>
            </AccordionItem>
          ))
        }</Accordion
      ></Fragment
    ></ContentWrapper
  ></Section
>


<script>
  document.querySelectorAll<HTMLElement>('[data-photo-credit]').forEach((credit) => {
    const button = credit.querySelector<HTMLButtonElement>('button');
    const panel = credit.querySelector<HTMLElement>('.home-programs_credit-panel');
    if (!button || !panel) return;

    const setOpen = (open: boolean, animate = true) => {
      credit.toggleAttribute('data-instant', !animate);
      credit.toggleAttribute('data-open', open);
      button.setAttribute('aria-expanded', String(open));
      panel.setAttribute('aria-hidden', String(!open));
      panel.inert = !open;
    };

    credit.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse' && matchMedia('(hover: hover) and (pointer: fine)').matches) setOpen(true);
    });
    credit.addEventListener('pointerleave', () => {
      if (!credit.contains(document.activeElement)) setOpen(false);
    });
    button.addEventListener('focus', () => {
      if (button.matches(':focus-visible')) setOpen(true, false);
    });
    button.addEventListener('click', (event) => setOpen(panel.inert, event.detail !== 0));
    credit.addEventListener('focusout', (event) => {
      if (!credit.contains(event.relatedTarget as Node | null)) setOpen(false, false);
    });
    credit.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      event.stopPropagation();
      button.focus({ preventScroll: true });
      setOpen(false, false);
    });
    document.addEventListener('pointerdown', (event) => {
      if (!credit.contains(event.target as Node)) setOpen(false);
    });
  });
</script>

<style is:global>
@layer components {

.home-trust_wrap { border-bottom:.0625rem solid var(--border); background:var(--dark-800); }
.home-trust_list { display:flex; align-items:center; justify-content:space-between; gap:1rem 2rem; width:100%; padding:1.125rem 0; list-style:none; }
.home-trust_list li { display:flex; align-items:center; gap:.75rem; font-size:1rem; font-weight:500; line-height:1.5; }
.home-trust_list li::before { content:''; width:.5rem; height:.5rem; flex:none; border-radius:50%; background:var(--blue); }
.home-trust_list li:nth-child(2)::before { background:var(--grapefruit); }
.home-trust_list li:nth-child(3)::before { background:var(--violet); }
.home-next_wrap { margin-top:2rem; }
.home-next_wrap[hidden] { display:none; }
.home-next_panel { width:100%; display:flex; align-items:center; gap:2.5rem; padding:1.75rem 2.125rem; border-left:.25rem solid var(--blue); background:var(--ice-dark); }
.home-next_panel .eyebrow_text { color:var(--blue); font-size:.75rem; margin-bottom:.625rem; }
.home-next_panel strong { display:block; font-weight:500; font-size:1.1875rem; letter-spacing:-.025em; }
.home-next_panel .heading { margin:0; font-size:1.375rem; letter-spacing:-.035em; line-height:1.3; }
.home-next_panel .text { margin:.375rem 0 0; font-size:.875rem; color:var(--text-2); }
.home-next_panel>.button_wrap { margin-left:auto; flex:none; }
.home-programs_wrap { gap:1.25rem; }
.home-programs_wrap .card_wrap { gap:0; --_visual-ratio:1; }
.home-programs_wrap .card_content { position:relative; padding:0; }
.home-programs_wrap .heading { font-size:1.375rem; line-height:1.3; letter-spacing:-.035em; margin:1.3125rem 0 .5rem; }
.home-programs_wrap .text { font-size:1rem; line-height:1.75; max-width:38ch; color:var(--text-2); margin:0; }
.home-programs_photo { display:block; position:relative; height:100%; width:100%; color:var(--text); overflow:hidden; --program-color:var(--blue); --program-wash:var(--ice-dark); }
.home-programs_wrap .card_wrap:nth-child(2) .home-programs_photo { --program-color:var(--grapefruit); --program-wash:var(--rose-dark); }
.home-programs_wrap .card_wrap:nth-child(3) .home-programs_photo { --program-color:var(--violet); --program-wash:var(--dark-700); position:absolute; inset:0; }
.home-programs_photo>.image { width:100%; height:100%; object-fit:cover; transition:transform .55s var(--ease-out); }
.home-programs_wrap .card_wrap:nth-child(3) .home-programs_photo>.image { object-position:50% 75%; }
.home-programs_label { position:absolute; top:1.125rem; left:1.125rem; padding:.5625rem .875rem; border-radius:.3125rem; transform:rotate(-3deg); background:var(--program-wash); color:var(--program-color); font-size:.8125rem; font-weight:500; }
.home-programs_wrap .card_wrap:nth-child(2) .home-programs_label { transform:rotate(2deg); }
.home-programs_number { position:absolute; bottom:1.4375rem; left:1.375rem; color:white; font-size:.8125rem; letter-spacing:.08em; text-shadow:0 .0625rem .25rem #111; }
.home-programs_arrow { position:absolute; bottom:1.125rem; right:1.125rem; width:2.75rem; height:2.75rem; border-radius:50%; display:grid; place-items:center; background:var(--program-wash); color:var(--program-color); }
.home-programs_arrow svg { width:1.125rem; height:1.125rem; }
.home-programs_wrap .card_wrap:nth-child(3) .card_visual { border-bottom-right-radius:0; }
.home-programs_credit { position:absolute; z-index:2; top:0; right:0; }
.home-programs_credit~.heading { padding-right:3rem; }
.home-programs_credit-trigger { position:relative; z-index:1; display:grid; place-items:center; width:2.75rem; height:2.75rem; padding:0; border:.0625rem solid var(--border); border-top:0; border-radius:0 0 .375rem .375rem; background:var(--dark-800); color:var(--text-2); cursor:pointer; }
.home-programs_credit-trigger:focus-visible { outline:.125rem solid var(--blue); outline-offset:-.25rem; }
.home-programs_credit-panel { position:absolute; top:calc(100% - .0625rem); right:0; width:max-content; opacity:0; transform:translateY(-.375rem) scale(.97); transform-origin:top right; pointer-events:none; transition:opacity 180ms var(--ease-out),transform 180ms var(--ease-out); }
.home-programs_credit[data-open] .home-programs_credit-panel { opacity:1; transform:translateY(0) scale(1); pointer-events:auto; }
.home-programs_credit[data-open] .home-programs_credit-trigger { border-bottom-color:transparent; border-radius:0; }
.home-programs_credit[data-instant] .home-programs_credit-panel { transition:none; }
.home-programs_credit-panel a { display:flex; align-items:center; gap:.625rem; min-height:2.75rem; padding:.625rem .75rem; border:.0625rem solid var(--border); border-radius:.375rem 0 .375rem .375rem; background:var(--dark-800); box-shadow:0 .25rem 1rem rgb(0 0 0 / 18%); color:var(--text); font-size:.75rem; line-height:1.5; white-space:nowrap; text-decoration:none; }
.home-programs_credit-panel a:focus-visible { outline:.125rem solid var(--blue); outline-offset:.125rem; }
@media(hover:hover) and (pointer:fine) { .home-programs_credit-trigger:hover,.home-programs_credit-panel a:hover { color:var(--blue); } }
@media(prefers-reduced-motion:reduce) { .home-programs_credit-panel { transform:none; transition:opacity 125ms var(--ease-out); } .home-programs_credit[data-open] .home-programs_credit-panel { transform:none; } }
.home-approach_wrap { background:var(--dark-800); }
.home-approach_content { max-width:28.4375rem; }
.home-approach_content .heading { font-size:clamp(2.1875rem,4vw,3.5rem); line-height:1.09; letter-spacing:-.05em; margin:1.5rem 0 1.625rem; }
.home-approach_content .heading em { color:var(--blue); font-style:normal; }
.home-approach_content>.text { font-size:1rem; color:var(--text-2); max-width:22.1875rem; margin:0; }
.home-approach_list { width:100%; margin-top:1.5625rem; }
.home-approach_list li { display:flex; align-items:center; gap:1.5rem; padding:.8125rem 0; border-bottom:.0625rem solid var(--border); font-size:1rem; }
.home-approach_list span { display:grid; place-items:center; flex:none; width:1.6875rem; height:1.6875rem; border-radius:50%; background:var(--ice-dark); color:var(--blue); font-size:.75rem; }
.home-approach_list li:nth-child(2) span { color:var(--grapefruit); background:var(--rose-dark); }
.home-approach_list li:nth-child(3) span { color:var(--violet); background:var(--dark-700); }
.home-approach_visual { min-width:0; }
.home-history_wrap { background:var(--dark-800); padding-block:4.6875rem 4.0625rem; }
.home-history_wrap>.container { gap:0; }
.home-history_wrap .section-heading_wrap .heading { font-size:clamp(2.3125rem,4.6vw,4.25rem); line-height:1.04; }
.home-history_wrap .heading em { font-style:normal; color:var(--blue); }
.home-history_wrap .eyebrow_text { color:var(--blue); }
.home-history_summary { display:grid; grid-template-columns:2fr repeat(3,1fr); align-items:center; gap:2rem; width:100%; margin:2.5rem 0 .5rem; }
.home-history_summary>div { display:grid; gap:.375rem; }
.home-history_summary strong { color:var(--blue); font-size:2.5rem; line-height:1.1; font-weight:400; letter-spacing:-.04em; }
.home-history_summary span { color:var(--text-2); font-size:.875rem; line-height:1.5; }
.home-history_summary .home-history_total { display:flex; align-items:center; gap:1.25rem; }
.home-history_total strong { font-size:5rem; }
.home-history_list { grid-template-columns:repeat(5,minmax(0,1fr)); gap:1.375rem; margin:2rem 0 1.5rem!important; }
.home-history_item { min-width:0; }
.home-history_year { display:block; color:var(--blue); font-size:clamp(1.5rem,2.5vw,2.875rem); font-weight:400; letter-spacing:-.065em; line-height:1.2; border-bottom:.0625rem solid var(--border); padding-bottom:1.25rem; margin-bottom:1.25rem; white-space:nowrap; }
.home-history_item .image { aspect-ratio:1.2; object-fit:cover; }
.home-history_placeholder { position:relative; display:grid; place-items:center; aspect-ratio:1.2; background:var(--dark-900); }
.home-history_placeholder span { color:var(--text-2); font-size:.6875rem; letter-spacing:.12em; text-transform:uppercase; }
.home-history_place { display:block; margin-top:.9375rem; font-size:1rem; }
.home-history_venue { display:block; color:var(--text-2); font-size:.75rem; line-height:1.5; margin-top:.375rem; }
.home-history_count { display:block; margin-top:.75rem; font-size:.875rem; line-height:1.5; font-weight:400; }
.home-history_note { color:var(--text-2); font-size:.75rem; margin-bottom:1.5rem; }
.home-history_signoff { display:flex; align-items:center; justify-content:space-between; gap:1.5rem; width:100%; }
.home-news_wrap { padding-top:1.5625rem; }
.home-news_wrap .grid { gap:1.75rem; }
.home-article.card_wrap { gap:0; }
.home-article .card_visual { aspect-ratio:1.4; }
.home-article_cover { display:block; position:relative; width:100%; height:100%; }
.home-article_cover>.image { width:100%; height:100%; object-fit:cover; }
.home-article_cover>span { position:absolute; bottom:1rem; left:1rem; border-radius:.1875rem; padding:.4375rem .75rem; background:var(--blue); color:var(--dark-900); font-size:.75rem; transform:rotate(-3deg); }
.home-article:nth-child(even) .home-article_cover>span { background:var(--grapefruit); transform:rotate(2deg); }
.home-article .card_content { padding:0; }
.home-article_meta { display:flex; width:100%; justify-content:space-between; margin-top:1.125rem; color:var(--text-2); font-size:.75rem; }
.home-article .heading { font-size:1.5625rem; letter-spacing:-.04em; line-height:1.2; margin:.8125rem 0; }
.home-article .text { font-size:1rem; color:var(--text-2); margin:0; }
.home-article .card_content>.button-wrapper { padding-top:.75rem; }
