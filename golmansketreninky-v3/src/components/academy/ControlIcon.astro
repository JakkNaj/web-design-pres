---
interface Props {
  name: "previous" | "next" | "expand" | "close";
}
const { name } = Astro.props;
const paths = {
  previous: "M19.5 12h-15m6-6-6 6 6 6",
  next: "M4.5 12h15m-6-6 6 6-6 6",
  expand: "M6 18 18 6M6 6h12v12",
  close: "M6 6l12 12M18 6 6 18",
};
---

<svg
  class="control-icon"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
  ><path
    d={paths[name]}
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"></path></svg
>
<style>
  .control-icon {
    display: block;
    flex: none;
    width: 20px;
    height: 20px;
  }
</style>
