---
import { Section, ContentWrapper, Heading, Paragraph, Eyebrow, Button } from '@/ui';
import Brand from './Brand.astro';
import Arrow from './Arrow.astro';
import { contact, url } from '@/lib/site';
interface Props { showCta?: boolean; }
const {showCta=true}=Astro.props;
---
<Section render={showCta} class="academy-footer_cta" id="dalsi-krok" aria-labelledby="contact-title">
  <ContentWrapper variant="auto-width" class="academy-footer_cta-layout">
    <Eyebrow>Vidíme se na ledě</Eyebrow>
    <Heading id="contact-title">Vyber si další trénink.</Heading>
    <Paragraph>Najdi termín a rezervuj si místo na ledě.</Paragraph>
    <Fragment slot="column2"><Button element="link" class="academy-blue" href={url('#terminy')}>Prohlédnout termíny <Arrow/></Button></Fragment>
  </ContentWrapper>
</Section>
<footer class="academy-footer_wrap" id="kontakt">
  <div class="academy-footer_top">
    <a class="academy-footer_brand" href={url()} aria-label="Altrichter Goalie Academy — úvod"><Brand/></a>
    <div><span class="academy-footer_label">DOMLUVÍME SE.</span><a href={`mailto:${contact.email}`}>{contact.email}<Arrow diagonal/></a>{contact.people.map(p=><a href={`tel:${p.tel}`}><span>{p.name}<br/>{p.phone}</span></a>)}</div>
    <div><span class="academy-footer_label">TADY JSME DOMA</span><p>{contact.venue}<br/>{contact.address}</p><a href={url('historie/')}>Příběh akademie <Arrow diagonal/></a><a href={url('kempy/')}>Vypsané kempy <Arrow diagonal/></a></div>
    <a class="academy-footer_back" href="#nahoru" aria-label="Zpět nahoru"><Arrow/></a>
  </div>
  <div class="academy-footer_legal"><span>© {new Date().getFullYear()} Altrichter Goalie Academy</span><span>Gólmanem. Po svém.</span></div>
</footer>

<style is:global>
@layer components {

.academy-footer_cta { background:var(--dark-800); border-block:.0625rem solid var(--border); padding-block:3.75rem; }
.academy-footer_cta>.container { gap:0; }
.academy-footer_cta-layout.layout { align-items:center; gap:2rem; }
.academy-footer_cta .eyebrow_text { font-size:.75rem; color:var(--blue); }
.academy-footer_cta .heading { font-size:clamp(2rem,4vw,3.25rem); letter-spacing:-.045em; line-height:1.1; margin:.875rem 0 .75rem; }
.academy-footer_cta .text { color:var(--text-2); font-size:1rem; margin:0; }
.academy-footer_cta .button_wrap { margin:0; }
.academy-footer_wrap { padding:3.25rem max(var(--gutter),calc((100vw - 96.875rem)/2)) 0; background:var(--dark-900); }
.academy-footer_top { display:flex; justify-content:space-between; align-items:start; gap:1.875rem; padding-bottom:2.8125rem; position:relative; }
.academy-footer_label { display:block; color:var(--text-2); font-size:.75rem; letter-spacing:.07em; margin-bottom:.625rem; }
.academy-footer_top>div>a { font-size:.875rem; display:flex; align-items:center; gap:1.25rem; min-height:2.75rem; line-height:1.7; color:var(--text); text-decoration:none; }
.academy-footer_top p { font-size:.875rem; line-height:1.7; margin:0; }
.academy-footer_back { border:.0625rem solid var(--border); border-radius:50%; width:2.75rem; height:2.75rem; flex:none; display:grid; place-items:center; }
.academy-footer_back svg { transform:rotate(-90deg); }
.academy-footer_legal { display:flex; justify-content:space-between; align-items:center; gap:1.25rem; min-height:3.75rem; border-top:.0625rem solid var(--border); font-size:.75rem; color:var(--text-2); }
.academy-footer_legal>span:nth-child(2) { color:var(--text); }
@media(width <= 48rem) { .academy-footer_top { flex-wrap:wrap; } .academy-footer_top>.academy-footer_brand { width:calc(100% - 4.625rem); } .academy-footer_back { position:absolute; right:0; } .academy-footer_top>div { flex:1; } }
@media(width <= 37.5rem) { .academy-footer_cta { padding-block:2.75rem; } .academy-footer_cta .heading { font-size:2.125rem; } .academy-footer_cta .text { font-size:.9375rem; } .academy-footer_wrap { padding-top:2.25rem; } .academy-footer_top { gap:1.5625rem; padding-bottom:1.875rem; } .academy-footer_top>div { flex-basis:100%; } .academy-footer_top>div>a { font-size:1rem; } .academy-footer_label { margin-bottom:.3125rem; } .academy-footer_legal { flex-wrap:wrap; justify-content:start; gap:.625rem 1.5rem; padding-block:1.3125rem; } }
}
</style>
