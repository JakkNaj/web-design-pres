      box-shadow: 0 1rem 3rem rgb(0 0 0 / 12%);
      overflow: hidden;
      isolation: isolate;
    }
    .goalie-save .save-scene {
      display: block;
      width: 100%;
      height: auto;
    }
    .goalie-save .art-coordinate {
      position: absolute;
      top: 1.5rem;
      left: 1.5rem;
      font-size: .8rem;
      letter-spacing: 0.1em;
      color: var(--blue);
    }
    .goalie-save .save-stamp {
      position: absolute;
      top: 20%;
