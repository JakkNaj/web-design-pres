---
interface Props {
  variant?: 'puck' | 'rink' | 'tactics';
  class?: string;
}
const { variant = 'puck', class: className = '' } = Astro.props;
---
<svg data-decor-motion={variant === 'puck' ? '' : undefined} class={`hockey-accent ${className}`} viewBox="0 0 200 180" fill="none" aria-hidden="true" focusable="false">
  {variant === 'puck' && <>
    <circle cx="113" cy="89" r="66" fill="var(--blue)" opacity=".1" />
    <g transform="rotate(-24 100 100)" stroke="var(--blue)" stroke-width="2" stroke-linejoin="round">
      <path d="M47 88v25c0 29 110 29 110 0V88" />
      <ellipse cx="102" cy="88" rx="55" ry="22" />
      <ellipse cx="102" cy="88" rx="43" ry="14" stroke-width="1.3" />
      <path d="M52 122v-9m9 15v-9m10 14v-9m11 12v-9m12 11v-9" opacity=".5" />
    </g>
    <path d="m20 82 26-12M18 101l18-8m126-57 13-13" stroke="var(--grapefruit)" stroke-width="3" stroke-linecap="round" />
    <circle cx="174" cy="139" r="5" fill="var(--grapefruit)" />
  </>}
  {variant === 'rink' && <>
    <g transform="rotate(12 100 90)" stroke-width="2">
      <rect x="27" y="22" width="146" height="136" rx="42" stroke="var(--blue)" />
      <path d="M27 90h146" stroke="var(--grapefruit)" />
      <path d="M31 60h138M31 120h138" stroke="var(--blue)" opacity=".7" />
      <circle cx="100" cy="90" r="22" stroke="var(--grapefruit)" />
      <circle cx="100" cy="90" r="4" fill="var(--grapefruit)" />
      <path d="M86 22v7c0 16 28 16 28 0v-7m-28 136v-7c0-16 28-16 28 0v7" stroke="var(--blue)" />
    </g>
    <circle cx="173" cy="34" r="7" fill="var(--grapefruit)" />
  </>}
  {variant === 'tactics' && <>
    <circle cx="93" cy="90" r="66" fill="var(--blue)" opacity=".08" />
    <path d="M30 142c73 0 25-92 114-98" stroke="var(--blue)" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="5 8" />
    <path d="m132 34 16 9-12 14" stroke="var(--blue)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="29" cy="142" r="7" fill="var(--blue)" />
    <circle cx="168" cy="39" r="17" stroke="var(--blue)" stroke-width="2" />
    <circle cx="48" cy="48" r="10" stroke="var(--grapefruit)" stroke-width="2" />
    <circle cx="148" cy="122" r="10" stroke="var(--grapefruit)" stroke-width="2" />
    <path d="m136 149 24-4" stroke="var(--grapefruit)" stroke-width="2" stroke-linecap="round" />
  </>}
</svg>
<style is:global>@layer components {
  .hockey-accent { display:block; height:auto; pointer-events:none; flex:none; }

@media(prefers-reduced-motion:no-preference) {
  .hockey-accent[data-motion-visible] { animation:academy-puck-drift var(--motion-decoration-duration) var(--ease-in-out); }
}
@keyframes academy-puck-drift {
  0%,100% { transform:translateY(0) rotate(0); }
  25%,65% { transform:translateY(-.25rem) rotate(3deg); }
  45%,85% { transform:translateY(-.0625rem) rotate(-1deg); }
}
}</style>
