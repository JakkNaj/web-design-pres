---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionPageIntro from "@/components/academy/SectionPageIntro.astro";
import ContentCoaches from "@/components/academy/ContentCoaches.astro";
import { Section, Heading, Paragraph } from "@/ui";
import { siteContent } from "@/lib/site";
const { coaches } = await siteContent();
---

<BaseLayout title="Trenéři hokejových brankářů" description="Poznej trenéry Altrichter Goalie Academy a jejich zkušenosti s přípravou hokejových brankářů."
  ><SectionPageIntro
    title="Tvůj tým za brankou."
    eyebrow="Lidé za tréninkem"
    description="Mistrovský titul, roky v extralize i každodenní práce s mládeží. Poznej trenéry, se kterými budeš pracovat na svém chytání."
  /><Section
    ><ContentCoaches coaches={coaches} detailed /><Heading variant="h3">Na práci se podíleli také.</Heading><Paragraph
      >{
        coaches
          .filter((c) => !c.data.portrait)
          .map((c) => c.data.name)
          .join(" - ")
      }</Paragraph
    ></Section
  ></BaseLayout
>
