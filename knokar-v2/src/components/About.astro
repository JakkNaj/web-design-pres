---
import { getLanguage, siteHref, translator } from '../i18n';

const language = getLanguage(Astro.url);
const t = translator(language);
---
<section class="sec about" id="onas" aria-labelledby="about-h">
<div class="wrap about-grid">
<div class="about-text">
<p class="label">{t("O nás")}</p>
<h2 class="h-display" id="about-h">{t("Vztah, který drží věci ")}<em>{t("v pohybu.")}</em></h2>
<p class="lead">{t("Zajišťujeme krátkodobý i dlouhodobý pronájem luxusních vozů a osobní servis pro klienty, kteří chtějí svou mobilitu řešit jako komplexní službu bez zbytečných starostí.")}</p>
<p class="clients">{t("Spolupracujeme se soukromými i firemními klienty.")}</p>
<a class="btn btn-primary" href={siteHref('/o-nas/', language)}>{t("Více o nás ")}<span class="arrow" aria-hidden="true">→</span></a>
</div>
<div class="about-side">
<div class="stat-box"><b>19</b><span>{t("let na trhu")}</span></div>
<div class="stat-box"><b>800<sup>+</sup></b><span>{t("klientů")}</span></div>
<div class="mission">
<h3 class="label">{t("Naše mise")}</h3>
<p>{t("Vytváříme privátní servis pro lidi, jejichž čas, soukromí a komfort mají hodnotu. Nasloucháme, předvídáme a zařizujeme – od každodenní mobility po situace, které se do běžného ceníku nevejdou.")}</p>
</div>
</div>
</div>
</section>
