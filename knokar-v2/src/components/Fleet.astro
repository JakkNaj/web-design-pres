---
import { getLanguage, siteHref, translator } from '../i18n';
import { Image } from 'astro:assets';
import { vehicles } from '../data/vehicles';

const language = getLanguage(Astro.url);
const t = translator(language);
---
<section class="sec fleet" id="vozy" aria-labelledby="fleet-h">
<div class="wrap">
<div class="sec-head">
<h2 class="h-1" id="fleet-h">{t("Vozy v pronájmu")}</h2>
<div class="sec-head-r">
<p>{t("Prohlédněte si vybrané vozy z naší nabídky. Dostupnost a podmínky konkrétního vozu s vámi rádi projdeme osobně.")}</p>
<a class="btn btn-secondary" href={siteHref('/vozovy-park/', language)}>{t("Celý vozový park")}</a>
</div>
</div>
<div class="cars">
{vehicles.map((car) => (
<article class="car">
<a class="car-img" href={siteHref(`/vozovy-park/${car.id === 'rr' ? 'rra' : car.id}/`, language)} aria-label={`${t('Zobrazit detail vozu')} ${car.name}`}>
<Image src={car.img} alt={t(car.alt)} style={`object-position: ${car.pos}`} widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 50vw" format="webp" quality={85} loading="lazy" />
<ul class="tags" aria-hidden="true"><li>{car.kw}</li><li>{t(car.fuel)}</li><li>4×4</li><li>{t(car.seats)}</li></ul>
</a>
<div class="car-body">
<h3>{car.name}</h3>
<div class="car-acts">
<a class="tlink" href={siteHref(`/vozovy-park/${car.id === 'rr' ? 'rra' : car.id}/`, language)}>{t("Detail vozu ")}<span class="arrow" aria-hidden="true">→</span></a>
</div>
</div>
</article>
))}
</div>
</div>
</section>
