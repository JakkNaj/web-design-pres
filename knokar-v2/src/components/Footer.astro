---
import { getLanguage, translator } from '../i18n';
import { Image } from 'astro:assets';
import knokar_logo_negativ_svg from '../assets/knokar-logo-negativ.svg';


const language = getLanguage(Astro.url);
const t = translator(language);
---
<footer class="ftr dark">
<div class="wrap">
<div class="ftr-top">
<div class="ftr-brand">
<Image src={knokar_logo_negativ_svg} alt={t("KNOKAR.cz — Pronájem luxusních vozidel")} loading="lazy" />
<p class="ftr-claim" lang={language}>{t("Klid ")}<span>{t("v pohybu")}</span></p>
</div>
<form class="nl" aria-labelledby="nl-h">
<h2 id="nl-h">{t("Novinky od KNOKAR do e-mailu")}</h2>
<p>{t("Chcete dostávat informace o nových vozech a dalších novinkách? Přihlaste se k odběru našeho newsletteru.")}</p>
<div class="nl-row">
<div class="field"><label for="d-nl">{t("E-mailová adresa")}</label><input id="d-nl" name="nl-email" type="email" autocomplete="email" placeholder={t("E-mailová adresa")} required="required"></div>
<button class="btn btn-light" type="submit" disabled aria-describedby="newsletter-note">{t("Přihlásit k odběru")}</button>
</div>
<label class="check" for="d-nl-gdpr"><input id="d-nl-gdpr" name="nl-gdpr" type="checkbox" required="required"><span>{t("Souhlasím se zasíláním newsletteru a zpracováním osobních údajů.")}</span></label>

<div class="notice" id="newsletter-note"><strong>{t("Ukázka návrhu:")}</strong>{t(" odběr zatím není napojený a e-mail nebyl uložen.")}</div>

</form>
</div>
<div class="ftr-cols">
<div class="ftr-col">
<h3>{t("Navigace")}</h3>
<ul>
<li><a href="#onas">{t("O nás")}</a></li>
<li><a href="#sluzby">{t("Naše služby")}</a></li>
<li><a href="#vozy">{t("Vozový park")}</a></li>
<li><a href="#aktuality">{t("Aktuality")}</a></li>
<li><a href="#kontakt">{t("Kontakt")}</a></li>
</ul>
</div>
<div class="ftr-col">
<h3>{t("Naše služby")}</h3>
<ul>
<li>{t("Krátkodobý pronájem vozů")}</li>
<li>{t("Dlouhodobý pronájem vozů")}</li>
<li>{t("Finanční servis")}</li>
<li>{t("Pronájem vozů s řidičem")}</li>
</ul>
</div>
<div class="ftr-col">
<h3>KNOKAR Showroom</h3>
<p>Knokar, s.r.o.<br>Kašperská 965/2<br>104 00 Praha 10 – Uhříněves</p>
</div>
<div class="ftr-col">
<h3>{t("Kontakt")}</h3>
<ul>
<li><a href="mailto:obchod@knokar.cz">obchod@knokar.cz</a></li>
<li><a href="tel:+420725949494">+420 725 94 94 94</a></li>
</ul>
</div>
</div>
<div class="ftr-bot">
<span>{t("© 2026 Knokar, s.r.o., IČO 28219228")}</span>
<span>{t("Pronájem luxusních vozů a osobní servis")}</span>
</div>
</div>
</footer>
