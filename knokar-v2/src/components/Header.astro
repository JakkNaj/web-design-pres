---
import { Image } from 'astro:assets';
import knokar_logo_pozitiv_svg from '../assets/knokar-logo-pozitiv.svg';

---
<header class="hdr">
<div class="hdr-shell">
<div class="hdr-in glass">
<svg class="grain" aria-hidden="true" focusable="false"><filter id="final-grain"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" stitchTiles="stitch"></feTurbulence><feColorMatrix type="saturate" values="0"></feColorMatrix></filter><rect width="100%" height="100%" filter="url(#final-grain)"></rect></svg>
<a class="hdr-logo" href="#top" aria-label="KNOKAR — na začátek stránky"><Image src={knokar_logo_pozitiv_svg} alt="KNOKAR.cz — Pronájem luxusních vozidel" loading="eager" /></a>
<nav class="nav" aria-label="Hlavní navigace">
<a href="#onas">O nás</a>
<div class="nav-dd">
<button type="button" aria-expanded="false" data-services-toggle aria-controls="dd-sluzby">Naše služby <svg class="chev" viewBox="0 0 10 10" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M1.5 3.5 5 7l3.5-3.5"></path></svg></button>

<div class="dd-panel glass" id="dd-sluzby" hidden>
<svg class="grain" aria-hidden="true" focusable="false"><rect width="100%" height="100%" filter="url(#final-grain)"></rect></svg>
<a href="#sluzby">Krátkodobý pronájem vozů</a>
<a href="#sluzby">Dlouhodobý pronájem vozů</a>
<a href="#sluzby">Finanční servis</a>
<a href="#sluzby">Další</a>
</div>

</div>
<a href="#vozy">Vozový park</a>
<a href="#aktuality">Aktuality</a>
<a href="#kontakt">Kontakt</a>
</nav>
<div class="hdr-act">
<div class="lang" role="group" aria-label="Jazyk">
<button type="button" class="on" aria-pressed="true" lang="cs">CZ</button>
<button type="button" aria-pressed="false" disabled title="Anglická verze se připravuje" aria-label="English — anglická verze se připravuje" lang="en">EN</button>
</div>
<a class="btn btn-primary btn-sm" href="#kontakt">Poslat poptávku</a>
<button class="menu-btn" type="button" aria-expanded="false" data-menu-toggle aria-controls="mobilni-menu">Menu</button>
</div>
</div>

<nav class="mnav glass" id="mobilni-menu" hidden aria-label="Mobilní navigace">
<svg class="grain" aria-hidden="true" focusable="false"><filter id="final-grain2"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" stitchTiles="stitch"></feTurbulence><feColorMatrix type="saturate" values="0"></feColorMatrix></filter><rect width="100%" height="100%" filter="url(#final-grain2)"></rect></svg>
<a class="ml" href="#onas">O nás <span aria-hidden="true">→</span></a>
<a class="ml" href="#sluzby">Naše služby <span aria-hidden="true">→</span></a>
<div class="msub">
<a href="#sluzby">Krátkodobý pronájem vozů</a>
<a href="#sluzby">Dlouhodobý pronájem vozů</a>
<a href="#sluzby">Finanční servis</a>
<a href="#sluzby">Další</a>
</div>
<a class="ml" href="#vozy">Vozový park <span aria-hidden="true">→</span></a>
<a class="ml" href="#aktuality">Aktuality <span aria-hidden="true">→</span></a>
<a class="ml" href="#kontakt">Kontakt <span aria-hidden="true">→</span></a>
<div class="mnav-foot">
<div class="lang" role="group" aria-label="Jazyk">
<button type="button" class="on" aria-pressed="true" lang="cs">CZ</button>
<button type="button" aria-pressed="false" disabled title="Anglická verze se připravuje" aria-label="English — anglická verze se připravuje" lang="en">EN</button>
</div>
<a class="btn btn-primary" href="#kontakt">Poslat poptávku</a>
<a class="btn btn-secondary" href="tel:+420725949494">Zavolat +420 725 94 94 94</a>
</div>
</nav>

</div>
</header>
