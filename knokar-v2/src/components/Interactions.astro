<script>
  import { testimonials } from '../data/testimonials';
  import { translator } from '../i18n';
  const t = translator(document.documentElement.lang === 'en' ? 'en' : 'cs');

  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('#mobilni-menu');
  const servicesButton = document.querySelector<HTMLButtonElement>('[data-services-toggle]');
  const services = document.querySelector<HTMLElement>('#dd-sluzby');
  const servicesGroup = servicesButton?.closest('.nav-dd');

  function setMenu(open: boolean, returnFocus = false) {
    if (!menu || !menuButton) return;
    menu.hidden = !open;
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.textContent = open ? t('Zavřít') : 'Menu';
    if (returnFocus) menuButton.focus();
  }

  function setServices(open: boolean, returnFocus = false) {
    if (!services || !servicesButton) return;
    services.hidden = !open;
    servicesButton.setAttribute('aria-expanded', String(open));
    servicesGroup?.classList.toggle('open', open);
    if (returnFocus) servicesButton.focus();
  }

  menuButton?.addEventListener('click', () => setMenu(Boolean(menu?.hidden)));
  servicesButton?.addEventListener('click', () => setServices(Boolean(services?.hidden)));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
  services?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setServices(false)));
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    if (!servicesGroup?.contains(event.target)) setServices(false);
    if (!menu?.contains(event.target) && !menuButton?.contains(event.target)) setMenu(false);
  });
  document.querySelector('.hdr')?.addEventListener('focusout', () => {
    requestAnimationFrame(() => {
      if (!servicesGroup?.contains(document.activeElement)) setServices(false);
      if (!menu?.contains(document.activeElement) && document.activeElement !== menuButton) setMenu(false);
    });
  });
  window.matchMedia('(min-width: 861px)').addEventListener('change', (event) => {
    if (event.matches) setMenu(false);
    else setServices(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (menu && !menu.hidden) setMenu(false, true);
    else if (services && !services.hidden) setServices(false, true);
  });

  let referenceIndex = 0;
  document.querySelectorAll<HTMLElement>('[data-ref-step]').forEach((button) => {
    button.addEventListener('click', () => {
      referenceIndex = (referenceIndex + Number(button.dataset.refStep) + testimonials.length) % testimonials.length;
      const [quote, name, role] = testimonials[referenceIndex];
      for (const [selector, text] of [
        ['[data-ref-quote]', t(quote)], ['[data-ref-name]', t(name)], ['[data-ref-role]', t(role)],
        ['[data-ref-count]', `${String(referenceIndex + 1).padStart(2, '0')} / ${String(testimonials.length).padStart(2, '0')}`],
      ]) {
        const element = document.querySelector(selector);
        if (element) element.textContent = text;
      }
    });
  });

  // No submission endpoint exists for the client preview.
  document.querySelectorAll('form').forEach((form) => form.addEventListener('submit', (event) => event.preventDefault()));
</script>
