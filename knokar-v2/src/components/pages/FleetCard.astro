---
import { Image } from 'astro:assets';
import type { FleetVehicle } from '../../data/fleet';
import { getLanguage, siteHref, translator } from '../../i18n';

interface Props { car: FleetVehicle; showBrand?: boolean }
const { car, showBrand = false } = Astro.props;
const language = getLanguage(Astro.url);
const t = translator(language);
const href = siteHref(`/vozovy-park/${car.id}/`, language);
---
<article class="car fleet-grid-card" data-fleet-car data-brand={car.brand}>
  <a class="car-img" href={href} aria-label={`${t('Zobrazit detail vozu')} ${car.name}`}>
    <Image src={car.img} alt={t(car.alt)} style={`object-position:${car.pos}`} widths={[360, 600, 900]} sizes="(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 33vw" format="webp" quality={85} loading="lazy" />
    <ul class="tags" aria-label={t('Hlavní parametry')}><li>{car.kw}</li><li>{t(car.fuel)}</li><li>4×4</li><li>{t(car.seats)}</li></ul>
  </a>
  <div class="car-body">
    <div><h3>{car.name}</h3>{showBrand && <span class="muted">{car.brand}</span>}</div>
    <div class="car-acts"><a class="tlink" href={href}>{t('Detail vozu')} <span class="arrow" aria-hidden="true">→</span></a></div>
  </div>
</article>
