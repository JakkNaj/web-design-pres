---
import { Image } from 'astro:assets';
import { getLanguage, translator, siteHref } from '../../i18n';
import '../../styles/services.css';
import '../../styles/short-rental.css';
import mercedesAmg from '../../assets/mercedes-amg-studio-wide.png';
import fleet_amg_gt63s_jpg from '../../assets/fleet-amg-gt63s.jpg';
import fleet_s400d_jpg from '../../assets/fleet-s400d.jpg';
import fleet_rr_autobiography_jpg from '../../assets/fleet-rr-autobiography.jpg';
import emblem_burgundy_svg from '../../assets/emblem-burgundy.svg';

const language = getLanguage(Astro.url);
const t = translator(language);
const href = (path: string) => siteHref(path, language);
---
<section class="ph short-rental-hero" aria-labelledby="ph-h">
<div class="ph-media">
<Image src={mercedesAmg} alt={t("Šedý Mercedes-AMG v tmavém studiu, pohled zepředu ze strany.")} widths={[480, 800, 1200, 1600, 1920]} sizes="(max-width: 640px) 640px, 100vw" format="webp" quality={85} loading="eager" fetchpriority="high" />
<div class="ph-shade"></div>
<div class="ph-content">
<div class="wrap">
<div class="ph-text">
<nav class="crumbs" aria-label={t("Drobečková navigace")}><a href={href("/")}>{t("KNOKAR")}</a><span aria-hidden="true">/</span><span aria-current="page">{t("Krátkodobý pronájem vozů")}</span></nav>
<h1 class="h-display ph-title" id="ph-h">{t("Vůz pro dobu, kdy ho ")}<span style="color: var(--champ)">{t("potřebujete")}</span></h1>
<p class="ph-lead">{t("Nabízíme krátkodobý pronájem vozů luxusních značek. Pomůžeme vám vybrat vhodný model, ověříme jeho dostupnost a následně domluvíme podmínky pronájmu.")}</p>
<div class="ph-ctas"><a class="btn btn-light" href="#poptavka">{t("Poptat vůz ")}<span class="arrow" aria-hidden="true">→</span></a><a class="btn btn-ghost-light" href="tel:+420725949494">+420 725 94 94 94</a></div>
</div>
</div>
</div>
</div>
</section>
<section class="sec" aria-labelledby="vyh-h">
<div class="wrap short-benefits">
<div class="short-benefits-intro">
<h2 class="h-1" id="vyh-h">{t("Výhody pronájmu s KNOKAR")}</h2>
<Image class="short-benefits-emblem" src={emblem_burgundy_svg} alt="" aria-hidden="true" loading="lazy" />
</div>
<ul class="short-benefits-list" role="list">
<li><span class="short-benefit-number" aria-hidden="true">01</span><h3>{t("Výběr z vozů luxusních značek")}</h3><p>{t("Vyberte si vůz podle svých představ a účelu cesty.")}</p></li>
<li><span class="short-benefit-number" aria-hidden="true">02</span><h3>{t("Osobní domluva")}</h3><p>{t("Vše s vámi probereme osobně. Nezatěžujeme vás s nadbytečnou administrativou, starosti necháváme na své straně.")}</p></li>
<li><span class="short-benefit-number" aria-hidden="true">03</span><h3>{t("Možnost vůz poznat předem")}</h3><p>{t("Po domluvě vám vůz rádi osobně představíme a zajistíme případně i projížďku.")}</p></li>
<li><span class="short-benefit-number" aria-hidden="true">04</span><h3>{t("Pohodlné předání a přistavení na dohodnuté místo")}</h3><p>{t("Vůz vám po domluvě přistavíme kamkoliv podle vaší preference – domů, do hotelu nebo kanceláře.")}</p></li>
</ul>
</div>
</section>
<section class="sec fleet" aria-labelledby="nab-h">
<div class="wrap">
<div class="sec-head">
<h2 class="h-1" id="nab-h">{t("Nabídka vozů")}</h2>
<div class="sec-head-r"><p>{t("Prohlédněte si vybrané vozy z aktuální nabídky. Dostupnost a podmínky konkrétního vozu s vámi rádi projdeme osobně.")}</p><a class="btn btn-secondary" href={href("/vozovy-park/")}>{t("Celý vozový park")}</a></div>
</div>
<div class="cars c3">
<article class="car">
<a class="car-img" href={href("/vozovy-park/amg/")} aria-label={t("Detail vozu Mercedes-Benz AMG GT 63 S+ 4MATIC")}>
<Image src={fleet_amg_gt63s_jpg} alt={t("Mercedes-Benz AMG GT 63 S+ 4MATIC v matně šedém laku, pohled zepředu ze strany.")} style="object-position: 50% 86%" widths={[480, 800, 1200]} sizes="(max-width: 1100px) 100vw, 50vw" format="webp" quality={85} loading="lazy" />
<ul class="tags" aria-hidden="true"><li>{t("470 kW")}</li><li>{t("benzín")}</li><li>{t("4×4")}</li><li>{t("4 místa")}</li></ul>
</a>
<div class="car-body"><h3>{t("Mercedes-Benz AMG GT 63 S+ 4MATIC")}</h3><div class="car-acts"><a class="tlink" href={href("/vozovy-park/amg/")}>{t("Detail vozu ")}<span class="arrow" aria-hidden="true">→</span></a></div></div>
</article>
<article class="car">
<a class="car-img" href={href("/vozovy-park/s/")} aria-label={t("Detail vozu Mercedes-Benz S 400d 4MATIC")}>
<Image src={fleet_s400d_jpg} alt={t("Mercedes-Benz S 400d 4MATIC v matném laku v showroomu.")} style="object-position: 50% 58%" widths={[480, 800, 1200]} sizes="(max-width: 1100px) 100vw, 50vw" format="webp" quality={85} loading="lazy" />
<ul class="tags" aria-hidden="true"><li>{t("243 kW")}</li><li>{t("nafta")}</li><li>{t("4×4")}</li><li>{t("5 míst")}</li></ul>
</a>
<div class="car-body"><h3>{t("Mercedes-Benz S 400d 4MATIC")}</h3><div class="car-acts"><a class="tlink" href={href("/vozovy-park/s/")}>{t("Detail vozu ")}<span class="arrow" aria-hidden="true">→</span></a></div></div>
</article>
<article class="car">
<a class="car-img" href={href("/vozovy-park/rra/")} aria-label={t("Detail vozu Range Rover Autobiography")}>
<Image src={fleet_rr_autobiography_jpg} alt={t("Černý Range Rover Autobiography před prodejnou, pohled zepředu ze strany.")} style="object-position: 60% 65%" widths={[480, 800, 1200]} sizes="(max-width: 1100px) 100vw, 50vw" format="webp" quality={85} loading="lazy" />
<ul class="tags" aria-hidden="true"><li>{t("250 kW")}</li><li>{t("nafta")}</li><li>{t("4×4")}</li><li>{t("5 míst")}</li></ul>
</a>
<div class="car-body"><h3>{t("Range Rover Autobiography")}</h3><div class="car-acts"><a class="tlink" href={href("/vozovy-park/rra/")}>{t("Detail vozu ")}<span class="arrow" aria-hidden="true">→</span></a></div></div>
</article>
</div>
</div>
</section>
<section class="sec" id="poptavka" aria-labelledby="poptavka-h">
<div class="wrap">
<div class="contact-grid">
<div class="contact-l">
<p class="label" style="margin: 0">{t("Krátkodobý pronájem")}</p>
<h2 class="h-2" id="poptavka-h">{t("Máte zájem o konkrétní vůz?")}</h2>
<p class="lead">{t("Zavolejte nám. Rádi s vámi osobně projdeme možnosti a domluvíme další postup.")}</p>
<Image class="call-emb" src={emblem_burgundy_svg} alt="" aria-hidden="true" loading="lazy" />
<div class="call">
<span>{t("Raději voláte?")}</span>
<a class="tel" href="tel:+420725949494">+420 725 94 94 94</a>
</div>
</div>
<form class="form" aria-label={t("Poptávkový formulář")} data-inquiry-form>
<div class="field">
<label for="d-name">{t("Jméno a příjmení *")}</label>
<input id="d-name" name="name" type="text" autocomplete="name" required="required">
</div>
<div class="field half">
<label for="d-tel">{t("Telefon *")}</label>
<input id="d-tel" name="tel" type="tel" autocomplete="tel" required="required">
</div>
<div class="field half">
<label for="d-mail">{t("E-mail *")}</label>
<input id="d-mail" name="email" type="email" autocomplete="email" required="required">
</div>
<div class="field">
<label for="d-msg">{t("Text zprávy")}</label>
<textarea id="d-msg" name="message" placeholder={t("O jakou službu máte zájem? Na co se potřebujete zeptat?")}></textarea>
</div>
<label class="check" for="d-gdpr"><input id="d-gdpr" name="gdpr" type="checkbox" required="required"><span>{t("Souhlasím se zpracováním osobních údajů. *")}</span></label>
<div class="notice" id="form-note"><strong>{t("Ukázka návrhu:")}</strong>{t(" formulář zatím není napojený a zpráva nebyla odeslána. Ozvěte se nám prosím telefonicky na ")}<a href="tel:+420725949494">+420 725 94 94 94</a>.</div>

<div class="form-foot">
<span class="req">{t("* povinné údaje")}</span>
<button class="btn btn-primary" type="submit" disabled aria-describedby="form-note">{t("Odeslat poptávku")}</button>
</div>
</form>
</div>
</div>
</section>
