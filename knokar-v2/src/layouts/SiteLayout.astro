---
import '../styles/global.css';
import { getLanguage, languageHref, translator } from '../i18n';
import '@fontsource/hanken-grotesk/latin-300.css';
import '@fontsource/hanken-grotesk/latin-ext-300.css';
import '@fontsource/hanken-grotesk/latin-400.css';
import '@fontsource/hanken-grotesk/latin-ext-400.css';
import '@fontsource/hanken-grotesk/latin-500.css';
import '@fontsource/hanken-grotesk/latin-ext-500.css';
import favicon from '../assets/emblem-burgundy.svg';
interface Props { title?: string; description?: string; }
const language = getLanguage(Astro.url);
const t = translator(language);
const { title = 'KNOKAR — Klid v pohybu', description = 'Privátní mobilita. Osobní servis. Krátkodobý i dlouhodobý pronájem luxusních vozů pro soukromé i firemní klienty.' } = Astro.props;
---
<!doctype html>
<html lang={language}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={t(description)} />
<meta name="robots" content="noindex, nofollow" />
<meta name="theme-color" content="#F3F0E9" />
<meta property="og:title" content={t(title)} />
<meta property="og:description" content={t(description)} />
<meta property="og:type" content="website" />
<link rel="alternate" hreflang="cs" href={new URL(languageHref('cs'), Astro.site)} />
<link rel="alternate" hreflang="en" href={new URL(languageHref('en'), Astro.site)} />
<link rel="icon" type="image/svg+xml" href={favicon.src} />
<title>{t(title)}</title>
</head>
<body><div class="kn"><a class="skip-link" href="#top">{t('Přejít na obsah')}</a><slot /></div></body>
</html>
