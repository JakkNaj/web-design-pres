---
import { Image } from 'astro:assets';
import knokarLogoPozitiv from '../assets/knokar-logo-pozitiv.svg';
---
<header class="hdr">
<div class="hdr-shell">
<div class="hdr-in glass">
<svg class="grain" aria-hidden="true" focusable="false"><filter id="knd-grain"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" stitchTiles="stitch"></feTurbulence><feColorMatrix type="saturate" values="0"></feColorMatrix></filter><rect width="100%" height="100%" filter="url(#knd-grain)"></rect></svg>
<a class="hdr-logo" href="#top" aria-label="KNOKAR — na začátek stránky"><Image src={knokarLogoPozitiv} alt="KNOKAR.cz — Pronájem luxusních vozidel" /></a>
<nav class="nav" aria-label="Hlavní navigace">
<a href="#onas">O nás</a>
<a href="#sluzby">Služby</a>
<a href="#vozy">Vozy</a>
<a href="#kontakt">Kontakt</a>
</nav>
<div class="hdr-act">
<a class="hdr-tel" href="tel:+420725949494">+420 725 94 94 94</a>
<a class="btn btn-primary btn-sm" href="#kontakt">Poslat poptávku</a>
<button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobilni-menu">Menu</button>
</div>
</div>

<nav class="mnav glass" id="mobilni-menu" hidden aria-label="Mobilní navigace">
<svg class="grain" aria-hidden="true" focusable="false"><filter id="knd-grain2"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" stitchTiles="stitch"></feTurbulence><feColorMatrix type="saturate" values="0"></feColorMatrix></filter><rect width="100%" height="100%" filter="url(#knd-grain2)"></rect></svg>
<a class="ml" href="#onas">O nás <span aria-hidden="true">→</span></a>
<a class="ml" href="#sluzby">Služby <span aria-hidden="true">→</span></a>
<a class="ml" href="#vozy">Vozy <span aria-hidden="true">→</span></a>
<a class="ml" href="#kontakt">Kontakt <span aria-hidden="true">→</span></a>
<div class="mnav-ctas">
<a class="btn btn-primary" href="#kontakt">Poslat poptávku</a>
<a class="btn btn-secondary" href="tel:+420725949494">Zavolat +420 725 94 94 94</a>
</div>
</nav>

</div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.querySelector<HTMLElement>('#mobilni-menu');
  if (button && menu) {
    const close = (restoreFocus = false) => {
      menu.hidden = true;
      button.setAttribute('aria-expanded', 'false');
      button.textContent = 'Menu';
      if (restoreFocus) button.focus();
    };
    button.addEventListener('click', () => {
      const open = menu.hidden;
      menu.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
      button.textContent = open ? 'Zavřít' : 'Menu';
    });
    menu.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) close();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) close(true);
    });
    document.addEventListener('click', (event) => {
      if (!menu.hidden && !menu.contains(event.target as Node) && !button.contains(event.target as Node)) close();
    });
    matchMedia('(min-width: 761px)').addEventListener('change', (event) => {
      if (event.matches) close(menu.contains(document.activeElement));
    });
  }
</script>
